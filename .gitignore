# build output — regenerated by `npm run build`, deployed by CI
/dist/

# node
/node_modules/

# raw scrape output — large, re-derivable; committed inputs live in public/assets/games
/assets/

# superseded first-pass design canvas (kept on disk, not in the repo)
/design/

# local tooling
/.venv/
/coverage/
*.log

# service-account credentials — these belong in a GitHub Actions secret and in a
# password manager, never in the tree. _source/indexnow-key.txt is deliberately
# not covered: that key is public by design and has to ship in the build.
*.p12
*.pem

# A downloaded Google key is named after its project (shipyard-506820-abc123.json),
# so no sensible pattern catches it by name. The repo root has exactly two tracked
# JSON files and a downloaded key lands right there, so ignore the root and name
# the two exceptions. Nested JSON — topics.json, play-data.json — is untouched.
/*.json
!/package.json
!/package-lock.json

# editor / OS
/.vscode/
.DS_Store
